#include <iostream>
#include<string>
using namespace std;

class teacher{
    //properties/attributes
    private:
     double salary;

    public:
 
    teacher(string name, string dept, string subject, double salary){
        this->name=name;
        this->dept=dept;
        this->subject=subject;
        this->salary=salary;
    }
    //copy constructor
    teacher(teacher &orgobj){//pass by reference
        cout<<"i am custom copy constructor";
        this->name=orgobj.name;
        this->dept=orgobj.dept;
        this->subject=orgobj.subject;
        this->salary=orgobj.salary;
    }
    
    string name;
    string dept;
    string subject;
   
//method\memeber function
  void getinfo(){
      cout<<"name "<<name<<endl;
      cout<<"subject "<<subject<<endl;
  }
};
int main() {
    teacher t1("rohan","computer","oops",25000 );//constructor call
    //t1.getinfo();
    teacher t2(t1);
    t2.getinfo();//default copy constructor
    return 0;
}
