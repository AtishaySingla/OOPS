#include <iostream>
#include<string>
using namespace std;

class person{
  public:
    string name;
    int age;
  ~person(){
        cout<<"parent destructor\n";
    }
   person(){
       cout<<"parent constructor\n";
   }
};
class student : public person {
    //name,age defined
    public:
    int rollno;

    student(){
        cout<<"child constructor\n";
    }
    ~student(){
        cout<<"child destructor\n";
    }
    void getinfo(){
        cout<<"name:"<<name<<endl;
         cout<<"age:"<<age<<endl;
         cout<<"roll no:"<<rollno<<endl;
    }
};
int main() {
  student s1;
    s1.name="rohan";
    s1.age=62;
    s1.rollno=1234;
    s1.getinfo();
    return 0;
}
