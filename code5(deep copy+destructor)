#include <iostream>
#include<string>
using namespace std;

class student{
public:
    string name;
    double* cgpaptr;

    student(string name,double cgpa){
        this->name=name;
       cgpaptr= new double;
        *cgpaptr=cgpa;
    }
    student(student &obj){
        this->name=obj.name;
        cgpaptr = new double;//deep copy
       *cgpaptr=*obj.cgpaptr;
    }

    //destructor
    ~student(){
    cout<<"i delete everything";
        delete cgpaptr;//memory leak
        
    }
void getinfo(){
    cout<<"name:"<<name<<endl;
    cout<<"cgpa:"<<*cgpaptr<<endl;
}
};
int main() {
    student s1("rahul kumar", 8.9);
 
    s1.getinfo() ;
    
    return 0;
}
